{
  "manifest_version": 3,
  "name": "Zuban Sense",
  "version": "1.0",
  "description": "Translate selected text between Urdu and English.",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "web_accessible_resources": [
  {
    "resources": ["fonts/AmarNastaleeq.ttf"],
    "matches": ["<all_urls>"]
  }
],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:5000"
  }
}
